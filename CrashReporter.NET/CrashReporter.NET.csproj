<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net48</TargetFrameworks>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CrashReporterDotNET</RootNamespace>
    <AssemblyName>CrashReporter.NET</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Default version for local builds; CI overrides it from the v* release tag (see .github/workflows/publish.yml). -->
    <Version>2.1.0</Version>
    <Company>RBSoft</Company>
    <Product>CrashReporter.NET</Product>
    <AssemblyTitle>CrashReporter.NET</AssemblyTitle>
    <Copyright>Copyright © 2012-2026 RBSoft</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!-- Always strong-name signed with the committed key, so the assembly identity is the same on every build machine.
       Strong naming is an identity, not a security boundary; committing the key is the recommended practice for open-source libraries. -->
  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>CrashReporter.NET.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>d3sync.CrashReporter.NET</PackageId>
    <Title>CrashReporter.NET</Title>
    <Authors>RBSoft, d3sync</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/d3sync/CrashReporter.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/d3sync/CrashReporter.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/d3sync/CrashReporter.NET/releases</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Description>Send crash reports of your desktop application developed using .NET 10 or .NET Framework 4.8 directly to your mail's inbox with full exception report, stack trace and screenshot.</Description>
    <PackageTags>exception reporter crash inbox email C# VB.NET WinForms WPF</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <!-- WinForms .resx files contain non-string resources (images), which .NET Framework needs preserialized when built with the .NET SDK. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CrashReporter.NET.Tests" PublicKey="" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Resources.Extensions" Version="10.0.0" />
    <Reference Include="System.Deployment" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

</Project>

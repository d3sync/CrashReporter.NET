<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net48</TargetFrameworks>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CrashReporterDotNET</RootNamespace>
    <AssemblyName>CrashReporter.NET</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Company>RBSoft</Company>
    <Product>CrashReporter.NET</Product>
    <AssemblyTitle>CrashReporter.NET</AssemblyTitle>
    <Copyright>Copyright © 2012-2026 RBSoft</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('CrashReporter.NET.snk')">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>CrashReporter.NET.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CrashReporter.NET.Official</PackageId>
    <Title>CrashReporter.NET</Title>
    <Authors>RBSoft</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ravibpatel/CrashReporter.NET</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/ravibpatel/CrashReporter.NET/releases</PackageReleaseNotes>
    <Description>Send crash reports of your desktop application developed using .NET 10 or .NET Framework 4.8 directly to your mail's inbox with full exception report, stack trace and screenshot.</Description>
    <PackageTags>exception reporter crash inbox email C# VB.NET WinForms WPF</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <!-- WinForms .resx files contain non-string resources (images), which .NET Framework needs preserialized when built with the .NET SDK. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Resources.Extensions" Version="10.0.0" />
    <Reference Include="System.Deployment" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

</Project>
